# ==========================================
# HELPER FUNCTIONS
# ==========================================
def style_ax(ax, title, xlabel=None, ylabel=None, rotate=False, size=13):
    """Apply a common title, labels and grid to an axis."""
    ax.set_title(title, fontsize=size, fontweight="bold")
    if xlabel:
        ax.set_xlabel(xlabel)
    if ylabel:
        ax.set_ylabel(ylabel)
    if rotate:
        ax.tick_params(axis="x", rotation=45)
    ax.grid(alpha=0.3)


def scatter_reg(ax, data, x, y, title, color, line_color="black", xlabel=None, ylabel=None):
    """Scatter plot with a regression line."""
    sns.scatterplot(data=data, x=x, y=y, color=color, s=90, alpha=0.75,
                    edgecolor="black", ax=ax)
    sns.regplot(data=data, x=x, y=y, scatter=False, color=line_color, ax=ax)
    style_ax(ax, title, xlabel, ylabel)


def hist(ax, data, x, title, color, bins=20, xlabel=None, ylabel=None):
    """Histogram with a KDE curve."""
    sns.histplot(data=data, x=x, bins=bins, kde=True, color=color,
                 edgecolor="black", alpha=0.75, ax=ax)
    style_ax(ax, title, xlabel, ylabel)


def new_canvas(title, figsize=(18, 12)):
    fig, axes = plt.subplots(2, 2, figsize=figsize)
    fig.suptitle(title, fontsize=20, fontweight="bold")
    return fig, axes


