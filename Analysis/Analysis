# ==========================================
# FEATURE ENGINEERING
# ==========================================
g1, g2 = "number of goals team1", "number of goals team2"

df["date"] = pd.to_datetime(df["date"])
df["total_goals"] = df[g1] + df[g2]
df["goal_difference"] = (df[g1] - df[g2]).abs()
df["high_scoring"] = df["total_goals"] >= 3

# Convert possession strings (e.g. "45%") to numbers
df["possession_team1_pct"] = df["possession team1"].str.replace("%", "").astype(float)
df["possession_team2_pct"] = df["possession team2"].str.replace("%", "").astype(float)
df["possession_difference"] = df["possession_team1_pct"] - df["possession_team2_pct"]


def get_match_outcome(row):
    if row[g1] > row[g2]:
        return f"{row['team1']} wins"
    if row[g1] < row[g2]:
        return f"{row['team2']} wins"
    return "Draw"


df["match_outcome"] = df.apply(get_match_outcome, axis=1)
df["tournament_stage"] = df["category"]

# Team 1 efficiency metrics
df["shooting_accuracy_team1"] = (df["on target attempts team1"] / df["total attempts team1"] * 100).fillna(0)
df["goal_efficiency_team1"] = (df[g1] / df["total attempts team1"] * 100).fillna(0)
df["pass_accuracy_team1"] = (df["passes completed team1"] / df["passes team1"] * 100).fillna(0)

print(df)

# ==========================================
# TEAM STANDINGS TABLE (team_df)
# NOTE: team_df was not defined in the original code, so it is built here
# from the match data (3 points for a win, 1 for a draw).
# ==========================================
records = []
for side, other in [(1, 2), (2, 1)]:
    part = pd.DataFrame({
        "Team": df[f"team{side}"],
        "Goals Scored": df[f"number of goals team{side}"],
        "Goals Conceded": df[f"number of goals team{other}"],
    })
    part["Wins"] = (part["Goals Scored"] > part["Goals Conceded"]).astype(int)
    part["Draws"] = (part["Goals Scored"] == part["Goals Conceded"]).astype(int)
    part["Losses"] = (part["Goals Scored"] < part["Goals Conceded"]).astype(int)
    records.append(part)

team_df = pd.concat(records).groupby("Team").agg(
    Wins=("Wins", "sum"), Draws=("Draws", "sum"), Losses=("Losses", "sum"),
    **{"Goals Scored": ("Goals Scored", "sum"), "Goals Conceded": ("Goals Conceded", "sum")}
).reset_index()

team_df["Matches Played"] = team_df["Wins"] + team_df["Draws"] + team_df["Losses"]
team_df["Goal Difference"] = team_df["Goals Scored"] - team_df["Goals Conceded"]
team_df["Points"] = team_df["Wins"] * 3 + team_df["Draws"]
team_df["Win Rate (%)"] = team_df["Wins"] / team_df["Matches Played"] * 100
team_df = team_df.sort_values(["Points", "Goal Difference", "Goals Scored"],
                              ascending=False).reset_index(drop=True)
team_df.insert(0, "Rank", team_df.index + 1)

